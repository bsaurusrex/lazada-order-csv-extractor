{
  "manifest_version": 3,
  "name": "Order History to CSV",
  "version": "2.4.2",
  "version_name": "2.4.2 dev SG amounts",
  "description": "Export your order history to CSV \u2014 every item, price, status and shop, with optional purchase dates. Works with Lazada.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Order History to CSV",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.lazada.co.th/*",
    "*://*.lazada.sg/*",
    "*://*.lazada.com.my/*",
    "*://*.lazada.co.id/*",
    "*://*.lazada.com.ph/*",
    "*://*.lazada.vn/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.lazada.co.th/*",
        "*://*.lazada.sg/*",
        "*://*.lazada.com.my/*",
        "*://*.lazada.co.id/*",
        "*://*.lazada.com.ph/*",
        "*://*.lazada.vn/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.lazada.co.th/*",
        "*://*.lazada.sg/*",
        "*://*.lazada.com.my/*",
        "*://*.lazada.co.id/*",
        "*://*.lazada.com.ph/*",
        "*://*.lazada.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "report.html"
      ],
      "matches": [
        "*://*.lazada.co.th/*",
        "*://*.lazada.sg/*",
        "*://*.lazada.com.my/*",
        "*://*.lazada.co.id/*",
        "*://*.lazada.com.ph/*",
        "*://*.lazada.vn/*"
      ]
    }
  ]
}